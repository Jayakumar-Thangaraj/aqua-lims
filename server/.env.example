# MongoDB must be a replica set (transactions). `npm run db` starts one on 27017.
MONGODB_URI=mongodb://127.0.0.1:27017/aqualims?replicaSet=rs0
API_PORT=4000
# Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
# Idle session timeout in minutes (XAF used 10).
SESSION_IDLE_MINUTES=10
# Set to true when served over HTTPS.
COOKIE_SECURE=false
# Initial passwords for the seeded accounts (they must be changed at first login).
SEED_ADMIN_PASSWORD=Admin@123
SEED_USER_PASSWORD=User@123
# Migration (npm run migrate): ODBC connection to the XAF SQL Server database and the temporary
# password given to migrated users who don't exist yet in MongoDB.
SQLSERVER_CONNECTION=Driver={ODBC Driver 17 for SQL Server};Server=(local)\SQL2022;Database=AquaLIMS;Trusted_Connection=yes;
MIGRATED_USER_PASSWORD=ChangeMe@123
